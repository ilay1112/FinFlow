{
  "version": 2,
  "builds": [
    { "src": "marketing/landing/index.html", "use": "@vercel/static" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/lp/?$", "dest": "/marketing/landing/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
