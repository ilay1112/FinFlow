{
  "version": 2,
  "builds": [
    {
      "src": "api/auth.ts",
      "use": "@vercel/node"
    },
    {
      "src": "marketing/landing/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(exchange|token|logout)",
      "dest": "/api/auth.ts?action=$1"
    },
    {
      "src": "/lp/?$",
      "dest": "/marketing/landing/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
